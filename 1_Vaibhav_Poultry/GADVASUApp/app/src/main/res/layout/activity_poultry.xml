<?xml version="1.0" encoding="utf-8"?>
<!-- Poultry: Broiler (batch) or Layer (daily) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/view_topbar" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Text.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:text="@string/poultry" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/poultry_note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileBroiler"
                    style="@style/Widget.Gadvasu.Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chick"
                        app:tint="@color/green" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="12dp" />

                    <TextView
                        style="@style/Text.TileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/broiler" />

                    <TextView
                        style="@style/Text.Tiny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/batch_model" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileLayer"
                    style="@style/Widget.Gadvasu.Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_egg"
                        app:tint="@color/green" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="12dp" />

                    <TextView
                        style="@style/Text.TileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/layer" />

                    <TextView
                        style="@style/Text.Tiny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/daily_model" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
